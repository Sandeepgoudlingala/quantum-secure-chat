# ==============================================================================
# HYBRID POST-QUANTUM CRYPTOGRAPHIC COMMUNICATION SYSTEM - ENVIRONMENT VARIABLES
# SECURITY WARNING: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!
# ==============================================================================

PROJECT_NAME="Hybrid PQC Communication System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Cryptographic & Authentication Secrets
# Generate production key using: openssl rand -hex 32
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_SUPER_SECRET_PQC_KEY_32_BYTES_HEX_STRING"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Post-Quantum Cryptography Parameters
ML_KEM_PARAMETER_SET="ML-KEM-768" # FIPS 203 Standard (Kyber-768)

# MySQL Database Configuration
MYSQL_SERVER="localhost"
MYSQL_PORT=3306
MYSQL_USER="pqc_user"
MYSQL_PASSWORD="pqc_secure_password"
MYSQL_DB="pqc_capstone_db"
DATABASE_URL="mysql+pymysql://pqc_user:pqc_secure_password@localhost:3306/pqc_capstone_db"

# Security & CORS Controls
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Storage Configuration
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE="100/minute"
AUTH_RATE_LIMIT_PER_MINUTE="5/minute"
